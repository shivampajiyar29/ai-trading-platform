# Application
APP_NAME=ai-trading-platform
APP_ENV=development
LOG_LEVEL=INFO

# Web/API
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_trading_platform
REDIS_URL=redis://localhost:6379/0

# Security — replace locally; never commit real values
JWT_SECRET=replace-with-a-local-secret
ENCRYPTION_KEY=replace-with-a-local-key

# External providers — intentionally empty until verified
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
AI_PROVIDER=
AI_API_KEY=

# Trading safety
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
AUTOMATED_LIVE_TRADING_ENABLED=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
