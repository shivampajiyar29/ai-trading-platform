# Application
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=api-gateway
APP_VERSION=0.1.0

# Trading isolation — live trading is OFF unless explicitly enabled.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
AUTOMATED_LIVE_TRADING_ENABLED=false
TRADING_KILL_SWITCH=false

# Database (not connected yet — placeholders only)
# DATABASE_URL=postgresql://user:pass@localhost:5432/ai_trading

# Redis (not connected yet)
# REDIS_URL=redis://localhost:6379

# Never commit real secrets. Use a secret manager in production.
